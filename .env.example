# Groq API key dari console.groq.com — dipakai oleh /api/konsultasi (server-side only)
GROQ_API_KEY=

# Model hemat token. Opsi free tier Sep 2026: openai/gpt-oss-20b (paling murah & cepat)
# atau openai/gpt-oss-120b (lebih pintar). Llama sudah enterprise-only per Agustus 2026.
GROQ_MODEL=openai/gpt-oss-20b
